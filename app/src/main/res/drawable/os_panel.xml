<?xml version="1.0" encoding="utf-8"?>
<!-- Dark brown panel with a gold border and bevelled (light top-left / dark bottom-right) edge. Original artwork. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#1C150C" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="@color/os_gold" /></shape></item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp"><shape><solid android:color="#6B5A3A" /></shape></item>
    <item android:left="5dp" android:top="5dp" android:right="3dp" android:bottom="3dp"><shape><solid android:color="#241B10" /></shape></item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp"><shape><solid android:color="@color/os_panel" /></shape></item>
</layer-list>

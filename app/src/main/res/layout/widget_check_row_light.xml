<?xml version="1.0" encoding="utf-8"?>
<!-- One tickable checklist item in the widget (fill-in intent toggles it). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_check_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp">
    <ImageView
        android:id="@+id/widget_check_box"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_check_off_light" />
    <TextView
        android:id="@+id/widget_check_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="8dp"
        android:textColor="@color/widget_text_light"
        android:textSize="14sp" />
</LinearLayout>

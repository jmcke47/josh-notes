<?xml version="1.0" encoding="utf-8"?>
<!-- Old School widget row: chatbox line ("Title: preview"), hitsplat for overdue reminders. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/os_chat_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">
    <ImageView
        android:id="@+id/widget_item_color"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="5dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_strip" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_item_title_img"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />
            <ImageView android:id="@+id/widget_item_clip" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginStart="3dp"
                android:importantForAccessibility="no" android:src="@drawable/os_ic_widget_attach" />
            <ImageView android:id="@+id/widget_item_bell" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginStart="3dp"
                android:importantForAccessibility="no" android:src="@drawable/os_ic_widget_bell" />
            <ImageView android:id="@+id/widget_item_pin" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginStart="3dp"
                android:importantForAccessibility="no" android:src="@drawable/os_ic_widget_pin" />
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_item_body_img"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
        <LinearLayout
            android:id="@+id/widget_item_checks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/widget_item_hitsplat"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/os_hitsplat"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_item_hitsplat_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:shadowColor="#FF000000"
            android:shadowDx="1.5"
            android:shadowDy="1.5"
            android:shadowRadius="0.01"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/settings" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                style="@style/SettingsHeader"
                android:text="@string/privacy" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:saveEnabled="false"
                android:id="@+id/app_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_lock" />
            <TextView
                android:id="@+id/app_lock_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/app_lock_desc"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/theme" />
            <RadioGroup
                android:id="@+id/theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:saveEnabled="false"
                android:id="@+id/dynamic_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dynamic_color" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:saveEnabled="false"
                android:id="@+id/level_ups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Old School: XP drops and level-up banners for ticked items and completed reminders" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:saveEnabled="false"
                android:id="@+id/sounds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Level-up and quest-complete sounds" />
            <TextView
                android:id="@+id/font_credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Old School theme uses the original OS Small pixel font and Pixelify Sans (both SIL Open Font License 1.1). Tap for licences."
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="24dp"
                android:text="@string/backup_title" />
            <TextView
                android:id="@+id/backup_folder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <TextView
                android:id="@+id/backup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:saveEnabled="false"
                android:id="@+id/backup_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_auto" />
            <LinearLayout
                android:id="@+id/backup_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backup_choose"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/backup_choose" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backup_now"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/backup_now" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backup_restore"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_restore" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/backup_help"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="24dp"
                android:text="@string/gdrive_title" />
            <TextView
                android:id="@+id/gdrive_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:saveEnabled="false"
                android:id="@+id/gdrive_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_auto" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gdrive_connect"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gdrive_connect" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gdrive_now"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_now" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gdrive_restore"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_restore" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/gdrive_disconnect"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gdrive_disconnect" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gdrive_help"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="24dp"
                android:text="@string/voice_action_title" />
            <RadioGroup
                android:id="@+id/voice_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="24dp"
                android:text="@string/dictation_trigger" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dictation_trigger_help"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <RadioGroup
                android:id="@+id/trigger_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/volume_silent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                android:text="Volume keys don't change volume while using the shortcut" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="While Josh Notes is open, holding a volume key starts dictation without moving the volume. A quick press still changes the volume by one step."
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="24dp"
                android:text="@string/dictation_engine_title" />
            <RadioGroup
                android:id="@+id/engine_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_model"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/delete_model" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:saveEnabled="false"
                android:id="@+id/check_updates_on_open"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Check for updates on open" />
            <TextView
                android:id="@+id/version_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOutline" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/advanced_toggle"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:text="@string/advanced" />
            <LinearLayout
                android:id="@+id/advanced_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/update_url_btn"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_url" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

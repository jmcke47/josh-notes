<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:menu="@menu/main_menu" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/empty_notes"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/new_note"
        app:icon="@drawable/ic_add" />

    <!-- Old School theme: minimap-style round button + stone tab bar (hidden otherwise). -->
    <ImageButton
        android:id="@+id/os_fab"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="64dp"
        android:background="@null"
        android:contentDescription="@string/new_note"
        android:scaleType="fitCenter"
        android:src="@drawable/os_minimap_fab"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/os_tabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:background="@drawable/os_panel"
        android:orientation="horizontal"
        android:padding="3dp"
        android:visibility="gone">
        <ImageButton
            android:id="@+id/tab_notes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/os_tab"
            android:contentDescription="@string/app_name"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/os_ic_scroll" />
        <ImageButton
            android:id="@+id/tab_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/os_tab"
            android:contentDescription="@string/search"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/os_ic_magnifier" />
        <ImageButton
            android:id="@+id/tab_archive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/os_tab"
            android:contentDescription="@string/show_archive"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/os_ic_chest" />
        <ImageButton
            android:id="@+id/tab_trash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/os_tab"
            android:contentDescription="@string/show_trash"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/os_ic_bin" />
        <ImageButton
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/os_tab"
            android:contentDescription="@string/settings"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/os_ic_wrench" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

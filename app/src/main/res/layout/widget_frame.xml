<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime widget frame for all themes (System/Light/Dark/Old School); see NotesWidgetProvider.buildViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="6dp"
            android:text="@string/app_name"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="visible" />
        <TextView
            android:id="@+id/widget_title_light"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="6dp"
            android:text="@string/app_name"
            android:textColor="@color/widget_text_light"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_title_dark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="6dp"
            android:text="@string/app_name"
            android:textColor="@color/widget_text_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_title_img"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/app_name"
            android:paddingHorizontal="6dp"
            android:scaleType="fitStart"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_mic"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:contentDescription="@string/dictate"
            android:src="@drawable/ic_mic_widget" />
        <ImageView
            android:id="@+id/widget_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:contentDescription="@string/new_note"
            android:src="@drawable/ic_add_widget" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_list_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">
        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />
        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/empty_notes"
            android:textColor="@color/widget_subtext"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>

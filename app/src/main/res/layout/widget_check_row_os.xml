<?xml version="1.0" encoding="utf-8"?>
<!-- Old School checklist item: stone checkbox + pixel-font text bitmap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_check_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="30dp"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp">
    <ImageView
        android:id="@+id/widget_check_box"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/os_ic_check_off" />
    <TextView
        android:id="@+id/widget_check_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingStart="6dp"
        android:textColor="#FF0000FF"
        android:textSize="13sp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/widget_check_text_img"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:paddingStart="6dp"
        android:scaleType="fitStart" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 quick widget (quick add + last note). One frame for every theme; NotesWidgetProvider styles it per theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:maxLines="1" android:paddingHorizontal="4dp" android:text="@string/app_name"
            android:textColor="@color/widget_text" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_title_light" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:maxLines="1" android:paddingHorizontal="4dp" android:text="@string/app_name"
            android:textColor="@color/widget_text_light" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/widget_title_dark" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:ellipsize="end" android:maxLines="1" android:paddingHorizontal="4dp" android:text="@string/app_name"
            android:textColor="@color/widget_text_dark" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
        <ImageView android:id="@+id/widget_title_img" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:contentDescription="@string/app_name" android:paddingHorizontal="4dp" android:scaleType="fitStart" android:visibility="gone" />
        <ImageView android:id="@+id/widget_mic" android:layout_width="32dp" android:layout_height="32dp" android:padding="5dp"
            android:contentDescription="@string/dictate" android:src="@drawable/ic_mic_widget" />
        <ImageView android:id="@+id/widget_add" android:layout_width="32dp" android:layout_height="32dp" android:padding="5dp"
            android:contentDescription="@string/new_note" android:src="@drawable/ic_add_widget" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/widget_list_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_item_bg">
        <LinearLayout
            android:id="@+id/quick_note"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView
                android:id="@+id/quick_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="visible" />
            <TextView
                android:id="@+id/quick_title_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <TextView
                android:id="@+id/quick_title_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <ImageView android:id="@+id/quick_title_img" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:importantForAccessibility="no" android:scaleType="fitStart" android:visibility="gone" />
            <TextView
                android:id="@+id/quick_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="6"
                android:textColor="@color/widget_subtext"
                android:textSize="12sp"
                
                android:visibility="visible" />
            <TextView
                android:id="@+id/quick_body_light"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="6"
                android:textColor="@color/widget_subtext_light"
                android:textSize="12sp"
                
                android:visibility="gone" />
            <TextView
                android:id="@+id/quick_body_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="6"
                android:textColor="@color/widget_subtext_dark"
                android:textSize="12sp"
                
                android:visibility="gone" />
            <ImageView android:id="@+id/quick_body_img" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:importantForAccessibility="no" android:scaleType="fitStart" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

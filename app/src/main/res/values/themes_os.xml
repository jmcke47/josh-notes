<resources>
    <!-- Josh Notes' Old School theme = the shared kit theme (oldschool-theme module) + app-only attributes. -->
    <style name="Theme.JoshNotes.OldSchool" parent="Theme.OldSchool">
        <item name="osContentOverlay">@style/ThemeOverlay.OldSchool.Parchment</item>
    </style>
    <style name="Theme.JoshNotes.OldSchool.Translucent" parent="Theme.JoshNotes.OldSchool">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
